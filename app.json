{
  "expo": {
    "name": "동글일기",
    "slug": "o-memo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "omemo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "backgroundColor": "#000000",
      "bundleIdentifier": "com.ryugs.o-memo",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "일기장 잠금을 해제하기 위해 Face ID를 사용합니다.",
        "ITSAppUsesNonExemptEncryption": false,
      }
    },
    "backgroundColor": "#000000",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFBFA",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ryugs.omemo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosClientId": "434139943-ushi0r2tj7bg1vaqern9o3ou7akouvq5.apps.googleusercontent.com",
          "iosUrlScheme": "com.googleusercontent.apps.434139943-ushi0r2tj7bg1vaqern9o3ou7akouvq5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "218b9026-948e-4dc5-be7d-37cfcdcffc9f"
      }
    },
    "owner": "ryugss-team"
  }
}
